# FastAPI task_backend environment variables
#
# IMPORTANT: Do not commit real secrets. Provide these via the platform/orchestrator.

# PostgreSQL connection (task_db preview runs on port 5001)
DATABASE_URL=postgresql://appuser:dbuser123@localhost:5001/myapp

# JWT signing secret (REQUIRED for auth to work)
JWT_SECRET=change-me-to-a-long-random-secret

# Optional JWT settings
JWT_ALG=HS256
JWT_EXPIRES_MINUTES=60

# CORS (comma-separated). Example:
# CORS_ORIGINS=http://localhost:3000,https://your-preview-frontend.example
CORS_ORIGINS=http://localhost:3000

# Cookie name for access token if using cookie auth
ACCESS_TOKEN_COOKIE_NAME=access_token
